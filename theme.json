{
  "color": [
    "#58a6ff",
    "#3fb950",
    "#d29922",
    "#f78166",
    "#bc8cff",
    "#f778ba",
    "#56d4dd",
    "#e6edf3",
    "#8b949e",
    "#7ee787"
  ],
  "textStyle": {
    "color": "#8b949e",
    "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "fontSize": 12
  },
  "title": {
    "textStyle": {"color": "#e6edf3", "fontWeight": 600, "fontSize": 16},
    "subtextStyle": {"color": "#8b949e", "fontSize": 12}
  },
  "legend": {
    "textStyle": {"color": "#8b949e", "fontSize": 12},
    "pageTextStyle": {"color": "#8b949e"},
    "inactiveColor": "#484f58"
  },
  "tooltip": {
    "backgroundColor": "#1c2128",
    "borderColor": "#30363d",
    "borderWidth": 1,
    "textStyle": {"color": "#e6edf3", "fontSize": 13},
    "extraCssText": "border-radius: 6px; box-shadow: 0 8px 24px rgba(0,0,0,0.4);"
  },
  "categoryAxis": {
    "axisLine": {
      "show": true,
      "lineStyle": {"color": "#30363d", "width": 1}
    },
    "axisTick": {"show": false},
    "axisLabel": {"color": "#8b949e", "fontSize": 11},
    "splitLine": {"show": false},
    "nameTextStyle": {"color": "#8b949e"}
  },
  "valueAxis": {
    "axisLine": {"show": false},
    "axisTick": {"show": false},
    "axisLabel": {"color": "#8b949e", "fontSize": 11},
    "splitLine": {
      "show": true,
      "lineStyle": {"color": "#21262d", "width": 0.5}
    },
    "nameTextStyle": {"color": "#8b949e"}
  },
  "line": {
    "smooth": false,
    "symbol": "circle",
    "symbolSize": 4,
    "lineStyle": {"width": 2},
    "itemStyle": {"borderWidth": 0},
    "emphasis": {
      "lineStyle": {"width": 3},
      "itemStyle": {"borderWidth": 2, "borderColor": "#0d1117"}
    }
  },
  "bar": {
    "barMaxWidth": 32,
    "itemStyle": {
      "borderRadius": [2, 2, 0, 0]
    },
    "emphasis": {
      "itemStyle": {"shadowBlur": 8, "shadowColor": "rgba(0,0,0,0.3)"}
    }
  },
  "scatter": {
    "symbol": "circle",
    "symbolSize": 8,
    "itemStyle": {"opacity": 0.75},
    "emphasis": {
      "itemStyle": {"opacity": 1, "shadowBlur": 8, "shadowColor": "rgba(0,0,0,0.3)"}
    }
  },
  "markLine": {
    "lineStyle": {"color": "#484f58", "type": "dashed"},
    "label": {"color": "#8b949e"}
  },
  "markArea": {
    "itemStyle": {"color": "rgba(88, 166, 255, 0.08)"}
  }
}
